# Python
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml

# Virtualenvs
.venv/
venv/
.audit-venv/

# Env / secrets
.env
.env.*
!.env.example
*.pem

# Local hackathon workflow state and raw working notes. Curated, redacted evidence
# belongs under assets/evidence/; these files may contain account or project details.
.devpost-hackathon-state.json
.tmp/

# GCP credentials. Bastion audits IAM for a living; a leaked service-account key in
# the repo of an access-governance project is the worst possible artifact to ship.
*-sa-key.json
*service-account*.json
application_default_credentials.json
gha-creds-*.json

# Captured IAM policy dumps — real project IDs, real principals, real email addresses.
# Redacted copies belong in assets/evidence/ and are committed deliberately, never by glob.
*.iam-policy.json
data/iam-raw/

# Raw screen captures. The takes that survived were copied into the archived demo-video folder
# under the names its DEMO_SCRIPT.md gave them; the rest are discarded attempts.
.takes/

# Logs
*.log

# OS / IDE
.DS_Store
desktop.ini
Thumbs.db
.vscode/
.idea/

# Captured terminal output. `gcloud ... add-iam-policy-binding` prints the resulting policy, so
# a redirected console log is a raw principal inventory - exactly what SECURITY.md forbids
# committing, and `git add -A` will happily stage it. One of these reached the index once.
*-output.txt
*-output.log
*.gcloud.log
manual-run-*.txt
console-*.txt
# Local Claude Code permission grants. These authorize an agent to run deploys against the live
# project, so they are machine-local by definition and must never travel with a public clone.
# This was ignored only by a personal ~/.config/git/ignore rule, which does not exist on CI or
# on anyone else's checkout - so the protection held only where it was least needed.
.claude/settings.local.json

# Hackathon demo media, archived under archive/hackathon-2026/. Per-sentence measurement probes
# are intermediate: the committed clip is the artifact.
archive/hackathon-2026/assets/demo-voiceover/probes/
archive/hackathon-2026/assets/demo-voiceover/auditions/
# Demo video assembly. Raw per-beat takes and intermediate renders are large binaries rebuilt by
# the archived assemble_demo_video.py; only the reviewed final cut was ever a candidate for
# tracking, and that is published to YouTube rather than committed.
archive/hackathon-2026/assets/demo-video/beats/
archive/hackathon-2026/assets/demo-video/build/
# The finished cut is ~20 MB and would add a fresh blob to history on every re-render. It is
# published to YouTube; the narration, the reviewed stills and the assembly script are kept.
archive/hackathon-2026/assets/demo-video/bastion.mp4

# Node tooling is run through npx or an out-of-tree install; never vendored here.
node_modules/
package-lock.json


# Durable private working notes, cloud captures, and report history.
.local/
