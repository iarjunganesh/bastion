# Google ADK / Vertex AI configuration. GOOGLE_CLOUD_* are the variables consumed by
# the ADK. GCP_PROJECT_ID is retained for Bastion's IAM and Model Armor adapters.
GOOGLE_CLOUD_PROJECT=bastion-fleet-2026
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GCP_PROJECT_ID=bastion-fleet-2026

# Region for Cloud Run, Firestore, and Pub/Sub. NOT the model location.
GCP_REGION=europe-north2

# Gemini 3.5 has no regional endpoint. Do not replace GOOGLE_CLOUD_LOCATION with
# GCP_REGION: doing so makes model calls fail. See docs/adr/004-flash-only-global-endpoint.md.
VERTEX_AI_MODEL=gemini-3.5-flash

FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC=bastion-investigations
# Required for deployment. These must name a managed, non-memory ADK session/memory service.
# The deploy script refuses `memory://`, because that would lose cross-week context on restart.
BASTION_SESSION_SERVICE_URI=
BASTION_MEMORY_SERVICE_URI=
# Inject from Secret Manager in Cloud Run; do not commit a value.
BASTION_FINDING_HMAC_KEY=
# Secret Manager secret ID used by infrastructure/deploy.sh (the value is never in this file).
BASTION_FINDING_HMAC_SECRET=bastion-finding-hmac
# The dashboard's read-only findings API (ADR-003). Not a Slack webhook — Slack is not
# among the twenty-one services, and the escalation surface was settled as the dashboard.
BASTION_FINDINGS_ENDPOINT=
MODEL_ARMOR_TEMPLATE_ID=bastion-guardrail
MODEL_ARMOR_LOCATION=europe-west4
