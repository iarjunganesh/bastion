# Bastion environment contract.
#
# Copy to `.env` and fill the REQUIRED values. Everything else already carries the default
# shown, and the default is what the deployed fleet uses - override only deliberately.
#
# NEVER put a secret VALUE in this file or in `.env`. Secrets live in Secret Manager and are
# referenced here by their secret *id*. The two variables that hold real secret material
# (BASTION_FINDING_HMAC_KEY, BASTION_A2A_SHARED_SECRET) are injected into Cloud Run from Secret
# Manager at deploy time and should stay empty locally unless you are debugging offline.
#
# `.env` and `.env.*` are gitignored. This file is the exception and is tracked deliberately.

# ---------------------------------------------------------------------------------------------
# REQUIRED - no default exists; deploy.sh, smoke_test, and the Runtime abort without these
# ---------------------------------------------------------------------------------------------

GCP_PROJECT_ID=bastion-fleet-2026
GOOGLE_CLOUD_PROJECT=bastion-fleet-2026

# gcloud projects describe $GCP_PROJECT_ID --format='value(projectNumber)'
GCP_PROJECT_NUMBER=

# The two managed Agent Engines. Both are reasoning-engine IDs, not display names.
# Discover with the agentplatform SDK; they are distinct engines and must not be swapped.
BASTION_RUNTIME_AGENT_ENGINE_ID=
BASTION_MEMORY_AGENT_ENGINE_ID=

# Managed, non-ephemeral ADK session/memory services. deploy.sh refuses `memory://`, because
# an ephemeral store loses the cross-week context the track's second obligation rests on.
#
# Use the FULL RESOURCE NAME, not the bare engine id:
#   agentengine://projects/<project-id>/locations/<AGENT_RUNTIME_REGION>/reasoningEngines/<id>
#
# ADK resolves a short-form `agentengine://<id>` against GOOGLE_CLOUD_LOCATION, which must stay
# `global` for Gemini. The Agent Engine is regional, so the short form looks for it in `global`
# and every session create fails with "The ReasoningEngine does not exist" - a 404 that reads
# like a missing engine when the engine is fine and only the region is wrong. The full resource
# name carries its own location, so the model and the session service stop fighting over one
# variable.
BASTION_SESSION_SERVICE_URI=
BASTION_MEMORY_SERVICE_URI=

# Secret Manager secret IDs. These name secrets; they are not the secret values.
BASTION_FINDING_HMAC_SECRET=bastion-finding-hmac

# ---------------------------------------------------------------------------------------------
# Regions - three distinct planes. Conflating them is the documented failure mode.
# ---------------------------------------------------------------------------------------------

# Gemini 3.5 has no regional endpoint. Replacing this with a compute region produces a
# misleading 404 and a false residency claim. See docs/adr/004-flash-only-global-endpoint.md.
GOOGLE_CLOUD_LOCATION=global

# Cloud Run, Firestore, Pub/Sub, Eventarc.
GCP_REGION=europe-north2

# Agent Runtime, Memory Bank, Gateway, Registry, Model Armor, and the audit bucket.
AGENT_RUNTIME_REGION=europe-west4
AGENT_REGISTRY_REGION=europe-west4
MODEL_ARMOR_LOCATION=europe-west4

# Overrides GOOGLE_CLOUD_LOCATION inside the managed Runtime process, which reserves that
# variable for its own region. Leave as `global` unless Gemini gains a regional endpoint.
BASTION_MODEL_LOCATION=global

# ---------------------------------------------------------------------------------------------
# Model and data plane
# ---------------------------------------------------------------------------------------------

GOOGLE_GENAI_USE_VERTEXAI=TRUE
VERTEX_AI_MODEL=gemini-3.5-flash
# Quoted deliberately: Firestore's default database is literally named `(default)`, and an
# unquoted value is bash array syntax that silently sources as `default` instead.
FIRESTORE_DATABASE="(default)"
PUBSUB_TOPIC=bastion-investigations
BASTION_DEAD_LETTER_TOPIC=bastion-investigations-dead-letter
BASTION_DEAD_LETTER_REVIEW_SUB=bastion-dead-letter-review

# ---------------------------------------------------------------------------------------------
# Managed governance surfaces
# ---------------------------------------------------------------------------------------------

MODEL_ARMOR_TEMPLATE_ID=bastion-guardrail
BASTION_AGENT_GATEWAY=bastion-egress
BASTION_GATEWAY_AUTH_POLICY=bastion-gateway-iap
BASTION_IAP_AUTH_EXTENSION=bastion-iap-enforcement
BASTION_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------------------------
# Deployment shape
# ---------------------------------------------------------------------------------------------

BASTION_MAX_INSTANCES=3
BASTION_MEMORY_LIMIT=1Gi
BASTION_IMAGE_REPOSITORY=cloud-run-source-deploy
# Defaults to the short commit SHA, so an image is always traceable to the code that built it.
BASTION_IMAGE_TAG=
# Set only to deploy a prebuilt image and skip the Cloud Build step entirely.
BASTION_IMAGE=

# ---------------------------------------------------------------------------------------------
# Wired by deploy.sh - set locally only to run a piece of the fleet by hand
# ---------------------------------------------------------------------------------------------

# The human who may approve exceptions, as a full IAM member string such as
# `user:someone@example.com` or `group:reviewers@example.com`. Re-applied on every deploy,
# because `gcloud run deploy` re-establishes the service IAM policy and would otherwise
# remove a grant made by hand - silently disabling the only path that creates an exception.
# This principal does not receive run.invoker: Cloud Run accepts only an audience-scoped ID
# token, which no user credential can mint. It is granted impersonation of the approver
# identity below instead, and is recorded as the person an approval was made on behalf of.
BASTION_APPROVER_PRINCIPAL=

# The service account a human approves through, as a bare email. deploy.sh injects this into
# the findings API, which refuses any other caller - every worker identity can reach the
# service, so reachability alone would let the Escalation Agent approve its own suppression.
# Unset means no approval is possible, which is the safe direction.
BASTION_APPROVER_IDENTITY=

# The private findings API. deploy.sh resolves and injects this; it is not a Slack webhook.
BASTION_FINDINGS_ENDPOINT=
# Both card URLs or neither. A half-configured pair raises rather than silently running all
# three agents in one process under one identity, which would void the least-privilege claim.
BASTION_AUDITOR_CARD_URL=
BASTION_ESCALATION_CARD_URL=

# Which agent package a worker container serves, and the canonical Cloud Run origin it
# advertises on its Agent Card. deploy.sh sets both per service; a wrong origin makes Cloud Run
# reject the ID token audience with 401.
BASTION_AGENT_DIR=
BASTION_SERVICE_URL=

# How long a worker holds an investigation lease before it is reclaimable.
BASTION_INVESTIGATION_LEASE_SECONDS=

# Secret Manager references for the origin-bound A2A credential.
BASTION_A2A_SHARED_SECRET_ID=bastion-a2a-shared-secret
BASTION_A2A_SHARED_SECRET_VERSION=latest

# ---------------------------------------------------------------------------------------------
# Secret VALUES - injected from Secret Manager in Cloud Run. Leave empty locally.
# ---------------------------------------------------------------------------------------------

BASTION_FINDING_HMAC_KEY=
BASTION_A2A_SHARED_SECRET=

# ---------------------------------------------------------------------------------------------
# CI federation - read only by infrastructure/provision_wif.sh, never by an agent
# ---------------------------------------------------------------------------------------------

# The GitHub repository allowed to impersonate the deploy identity, exactly `owner/repo`.
# This single value is the security boundary of the federation: Google accepts any token
# GitHub's issuer signs, and GitHub signs one for every repository on the platform, so the
# provider's attribute condition pinning this is what makes the trust specific rather than
# global. Empty here because it belongs to whoever forked the repository, not to this file.
BASTION_GITHUB_REPOSITORY=
# Pool and provider ids. Defaults are fine; they name resources, not permissions.
BASTION_WIF_POOL=github-pool
BASTION_WIF_PROVIDER=github-provider

# ---------------------------------------------------------------------------------------------
# Local/offline only
# ---------------------------------------------------------------------------------------------

# `local` uses the SQLite durable store for fast tests; `firestore` uses the managed database.
BASTION_DURABLE_STORE_BACKEND=local
# Cloud Run injects PORT; only set this to run a service by hand.
PORT=8080
